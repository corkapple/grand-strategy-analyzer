{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grand Strategy Analyzer",
  "version": "0.1.21",
  "identifier": "app.grandstrategy.analyzer",
  "build": {
    "beforeDevCommand": "npm run prepare:bundle && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grand Strategy Analyzer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/bridge/": "bridge/"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRTc0RjM5NjlCOTcxOTQKUldTVWNibHBPVS9uVS9HQnVWYzgvSkJaNmVyUGNyOWF1MzVjL2dGOVNNUEF5bUJady91MDc0bCsK",
      "endpoints": [
        "https://gsa-community-udz745.netlify.app/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
